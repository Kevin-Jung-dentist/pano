{
  "name": "pano",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-10-15",
  "vars": {
    "APP_ORIGIN": "https://pano-9kh.pages.dev",
    "SCORED_PER_ROUND": "3",
    "TRAINING_MIN_SCORE": "50",
    "PAYPAL_ENABLED": "false",
    "PAYPAL_PRICE_USD": "19.00"
  },
  "env": {
    "production": {
      "vars": {
        "APP_ORIGIN": "https://pano-9kh.pages.dev",
        "SCORED_PER_ROUND": "3",
        "TRAINING_MIN_SCORE": "50",
        "PAYPAL_ENABLED": "false",
        "PAYPAL_PRICE_USD": "19.00"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pano-game",
          "database_id": "0146b254-6425-4604-ad93-aaf7022bbf52",
          "migrations_dir": "migrations"
        }
      ],
      "services": [
        {
          "binding": "IMAGE_SERVICE",
          "service": "pano-images"
        }
      ]
    },
    "preview": {
      "vars": {
        "APP_ORIGIN": "https://pano-9kh.pages.dev",
        "SCORED_PER_ROUND": "3",
        "TRAINING_MIN_SCORE": "50",
        "PAYPAL_ENABLED": "false",
        "PAYPAL_PRICE_USD": "19.00"
      },
      "d1_databases": [],
      "services": []
    }
  }
}
